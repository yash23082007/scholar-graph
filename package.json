{
  "name": "scholargraph",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:server:dev\" \"npm:client:dev\"",
    "client:dev": "vite --host 0.0.0.0",
    "server:dev": "node --watch server/index.js",
    "build": "tsc --noEmit && vite build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "node server/index.js",
    "test": "node --test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "cors": "^2.8.5",
    "diff": "^9.0.0",
    "dompurify": "^3.4.17",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mammoth": "^1.13.0",
    "marked": "^18.1.3",
    "mongoose": "^8.9.5",
    "multer": "^2.5.0",
    "pdfjs-dist": "^6.5.438",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "prettier": "^3.5.3",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}
