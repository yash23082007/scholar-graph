NODE_ENV=development
APP_URL=http://localhost:5173
PORT=4000
WEB_PORT=8080
TRUST_PROXY_HOPS=2
MONGODB_URI=mongodb://127.0.0.1:27017/scholargraph
SESSION_TTL_DAYS=7
RATE_LIMIT_HASH_SECRET=
METRICS_TOKEN=
MAX_UPLOAD_MB=20
MAX_FILES_PER_UPLOAD=10
STORAGE_DRIVER=local
S3_BUCKET_NAME=
S3_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
CLAMAV_HOST=
CLAMAV_PORT=3310
REQUIRE_CLAMAV=false
OCR_ENABLED=false
OCR_LANG=eng
OCR_MAX_PAGES=20
OCR_TIMEOUT_MS=30000
TAVILY_API_KEY=
OPENALEX_API_KEY=
CROSSREF_MAILTO=
CROSSREF_MIN_INTERVAL_MS=1000
SCHOLARLY_CACHE_TTL_MS=300000
# === Model Registry (NEW) ===
# The model registry (config/models.yaml) defines which models handle which roles.
# These settings control registry behavior and budget limits.
MODEL_CONFIG_PATH=config/models.yaml
MODEL_VALIDATE_ON_BOOT=true
MODEL_VALIDATE_STRICT=true
LLM_DAILY_BUDGET_USD=5.00
LLM_BUDGET_DEGRADE_AT=0.90
PROVIDER_TIMEOUT_MS=30000
PROVIDER_MAX_RETRIES=3

# === Provider API Keys ===
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434

# === DEPRECATED: Direct Model Selection ===
# These variables are DEPRECATED and will be removed in a future release.
# Model selection now happens in config/models.yaml by role.
# Setting these will log a deprecation warning.
# GROQ_MODEL=llama-3.3-70b-versatile    # DEPRECATED - retired Aug 2026
# GEMINI_MODEL=gemini-2.5-flash         # DEPRECATED - use registry
# AI_PROVIDER=groq                      # DEPRECATED - use registry
# OLLAMA_CHAT_MODEL=llama3.2:3b         # DEPRECATED - use registry
